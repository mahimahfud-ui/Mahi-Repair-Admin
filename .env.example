# Browser-safe values only.
NEXT_PUBLIC_SUPABASE_URL=https://shwqsljicmhflnvjqjah.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PROJECT_KEY

# Server-only identifier for the existing Supabase Owner account.
# Never use the NEXT_PUBLIC_ prefix; this value must not reach the browser.
ADMIN_OWNER_EMAIL=owner@example.com

# The Owner enters an 8–12 digit numeric PIN.
# Set it as the existing Owner account's Supabase Auth password in the Dashboard.
# Never store the PIN in this file, source control, browser storage or logs.

# Keep privileged keys out of this application:
# SUPABASE_SERVICE_ROLE_KEY=<never add to this app>
# RECIPE_SIGNING_PRIVATE_KEY_PEM=<store only in Supabase Edge Function Secrets>
# ADMIN_ORIGIN=<exact HTTPS Admin Panel origin; Supabase Edge Function Secret>
