# Browser-safe values shared with the Mahi Repair Android client.
NEXT_PUBLIC_SUPABASE_URL=https://shwqsljicmhflnvjqjah.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PROJECT_PUBLISHABLE_KEY
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only identifier for the existing Supabase Owner Auth account.
# The Owner signs in using an 8–12 digit PIN. This email is internal only:
# it is never requested from the Owner or shown in the browser.
ADMIN_OWNER_EMAIL=owner@example.com

# Never add privileged credentials to this application.
# SUPABASE_SERVICE_ROLE_KEY=<keep only in Supabase Edge Function Secrets>
# RECIPE_SIGNING_PRIVATE_KEY_PEM=<keep only in Supabase Edge Function Secrets>
